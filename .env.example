# Logging
LOG_LEVEL=INFO

# News API (NewsAPI.org)
NEWS_API_KEY=your_newsapi_key_here
TOP_SYMBOLS=AAPL,MSFT,NVDA,AMZN,TSLA,GOOGL,META,AMD,INTC,PLTR
ARTICLES_PER_SYMBOL=3
NEWS_LOOKBACK_HOURS=24

# SQS URL (only needed if running Lambdas outside SAM, optional for `sam local`)
SQS_QUEUE_URL=

# Claude / Anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# DynamoDB
DYNAMODB_TABLE_NAME=TradingNewsSentiment

# Lambda 3 ARN (only needed if running Lambdas outside SAM)
TRADE_EXECUTOR_FUNCTION_ARN=

# Alpaca (paper trading)
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_PAPER=true

# Trade sizing (pick one)
TRADE_NOTIONAL_USD=1000
# TRADE_QTY=10

# Trade behavior
ENABLE_SHORTS=false
SENTIMENT_BUY_THRESHOLD=0.2
SENTIMENT_SELL_THRESHOLD=-0.2

